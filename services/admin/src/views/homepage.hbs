{{#*inline "page"}}

<h2>Games</h2>
<div>
    {{#each games as |game|}}
        <a href="/games/{{game.id}}">
            <img
                width="156"
                src="{{game.box_art_url}}"
                alt="Thumbnail"
                {{#if game.is_paused}} style="filter: brightness(30%);" {{/if}}
            >
        </a>
    {{/each}}
</div>

<h3>Add a new one</h3>
<form action="/search/games" method="get">
    <input type="text" name="q" placeholder="what's the game?">
    <button>Search for matches</button>
</form>

<h2>Groups</h2>
<ul>
    {{#each groups as |group|}}
        <li>
            <a href="/groups/{{ group.id }}">{{ group.name }}</a>

            {{!-- a coloured cube --}}
            <div style="
                    display: inline-block;
                    width: 1em;
                    height: 1em;
                    background-color: {{ group.color }};
                    margin-left: 0.5em;
                    border: 2px solid black;"></div>
        </li>
    {{/each}}
</ul>

{{!-- TODO: explain groups --}}

<h2 style="color: red">Danger zone</h2>
<p>
    <form
        action="/dev/reset/post"
        method="post"
        onsubmit="return confirm('This will delete everything, continue?')"
    >
        <button>
            Hard delete of all data
        </button>
    </form>
</p>

<p>
    View and edit settings <a href="/settings">here</a>.
</p>

{{/inline}}
